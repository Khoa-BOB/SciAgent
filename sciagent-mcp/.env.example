# Outbound -- this service's own entry in the KG Service's
# KG_SERVICE_ALLOWED_KEYS allowlist. See specs/02-mcp-architecture.md §6.
KG_SERVICE_BASE_URL=http://localhost:8000
KG_SERVICE_API_KEY=

# Inbound -- comma-separated allowlist of Bearer tokens the Agent
# Orchestrator (or any other caller) presents to this service's Streamable
# HTTP endpoint. See specs/02-mcp-architecture.md §6.
MCP_ALLOWED_KEYS=

# Streamable HTTP bind address. Leave HOST=127.0.0.1 for local dev; the
# Docker image overrides this to 0.0.0.0 so the published port is reachable
# (see Dockerfile).
HOST=127.0.0.1
PORT=8100

# Optional: extra Host header values to accept on the /mcp endpoint, beyond
# the automatic 127.0.0.1/localhost allowance -- needed when this service
# sits behind a reverse proxy or a non-loopback hostname in production,
# otherwise every request gets a 421. Comma-separated; "host:*" matches any
# port. Leave unset for local dev. See mcp_service/config.py.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
