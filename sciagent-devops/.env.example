# Copy to .env in this directory: `cp .env.example .env`
# Consumed by docker-compose.yaml for both the neo4j and kg-service
# services. See README.md sections 2-3 and 6-7.

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme-strong-password
NEO4J_DATABASE=neo4j

# Comma-separated allowlist of service-to-service API keys the KG Service
# will accept via the X-Service-Key header. Invent your own for local/dev use.
KG_SERVICE_ALLOWED_KEYS=dev-key-1
