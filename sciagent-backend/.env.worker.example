# Env for the ingest WORKER process (kg_service.worker), NOT the API
# process (kg_service.main:app) -- run separately:
#   uv run python -m kg_service.worker
# See kg_service/jobs.py's docstring and specs/02-kg-service-architecture.md §8.

# Neo4j -- READ-WRITE credentials. This is the only place besides
# sciagent-KG's own CLIs that should ever hold write access to the graph.
# Do NOT set these on the kg_service.main:app (API) process -- only this
# worker. See specs/04-kg-service-nfr-testing-deployment.md §3.
KG_WRITE_NEO4J_URI=bolt://localhost:7687
KG_WRITE_NEO4J_USERNAME=kg_ingest_write
KG_WRITE_NEO4J_PASSWORD=

# Same MinIO bucket the API process uploads into -- this process downloads
# from it. Same values as sciagent-backend/.env.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_INGEST_BUCKET=kg-ingest-uploads

# Same Redis instance the API process enqueues into -- this process
# dequeues and runs the job.
REDIS_URL=redis://localhost:6379/0

# Optional entity-extraction follow-up (POST /v1/ingest-jobs with
# run_extraction=true) -- only read/used if a caller actually requests it.
# Defaults match sciagent-KG's own extract.py CLI default (local Ollama,
# free but lower quality -- see sciagent-KG/docs/entity_extraction_pipeline.md
# "Model choice matters a lot for quality" before using this in production).
# Point at OpenAI (https://api.openai.com/v1) + set EXTRACTION_API_KEY (or
# OPENAI_API_KEY) for meaningfully better extraction quality, at real cost
# per paper -- see specs/02-kg-service-architecture.md §8.5.
EXTRACTION_BASE_URL=http://localhost:11434/v1
EXTRACTION_MODEL=zephyr:latest
EXTRACTION_API_KEY=
