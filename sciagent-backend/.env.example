# Neo4j -- READ-ONLY credentials for this service, separate from
# sciagent-KG's ingestion/extraction credentials.
# See specs/04-kg-service-nfr-testing-deployment.md §3.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=kg_service_readonly
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Comma-separated allowlist of service-to-service API keys.
# See specs/02-kg-service-architecture.md §6.
KG_SERVICE_ALLOWED_KEYS=

# Separate, smaller allowlist for the /v1/ingest-jobs write path -- a caller
# with only a KG_SERVICE_ALLOWED_KEYS key must NOT be able to trigger a
# write. See specs/02-kg-service-architecture.md §8.
KG_SERVICE_WRITE_ALLOWED_KEYS=

# MinIO (S3-compatible) staging for uploaded ingest files. This process only
# ever PUTs here -- it never reads back or touches Neo4j for the write path,
# see kg_service/jobs.py. Same values as the ingest worker's .env.worker.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_INGEST_BUCKET=kg-ingest-uploads

# Redis-backed job queue (RQ) -- this process only enqueues, never dequeues
# or executes ingest jobs. See specs/02-kg-service-architecture.md §8.
REDIS_URL=redis://localhost:6379/0

# Reject an ingest upload above this size before it reaches MinIO or the
# worker. See specs/03-kg-service-api-spec.md §9.
MAX_INGEST_FILE_BYTES=209715200
